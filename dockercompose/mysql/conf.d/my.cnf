[mysqld]
# ========== 字符集 ==========
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# ========== 连接与性能 ==========
skip-name-resolve
lower_case_table_names = 1
max_connections = 500
innodb_buffer_pool_size = 512M
innodb_log_file_size = 256M

# ========== 慢查询日志 ==========
slow_query_log = 1
long_query_time = 5
slow_query_log_file = /var/log/mysql/slow.log

# ========== Binlog 配置（新增） ==========
# 启用 Binlog，指定日志文件基名
log-bin = mysql-bin
# 必须设置，1-4294967295 之间的唯一整数
server-id = 1
# 使用 ROW 格式（MySQL 8.4 默认值，显式声明以确保）
binlog-format = ROW
# 记录所有列的完整信息，而非仅变更列
binlog_row_image = FULL
# Binlog 保留 7 天（604800 秒），防止磁盘被日志占满
binlog_expire_logs_seconds = 604800
# 每次事务提交都将 Binlog 刷入磁盘，保证数据安全
sync_binlog = 1